    "Decontamination Process Started.": {
        "chi": "净化过程已开始！"
    },
    "20 Seconds Remaining. Stay here and defend.": {
        "chi": "还剩20秒。呆在这里守卫。"
    },
    "The doors are unlocked! Activate the eyescanner and keep moving forward!": {
        "chi": "门没锁！启动目测仪，继续前进！"
